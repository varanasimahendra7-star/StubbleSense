APP_NAME=StubbleSense
APP_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./stubble_sense.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Session Security
# REQUIRED in all environments (both local development and production):
# Must be explicitly configured with at least 32 cryptographically secure random characters.
JWT_SECRET=replace_this_with_a_secure_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie Security
# IN PRODUCTION: COOKIE_SECURE defaults to true and requires HTTPS.
# For local HTTP development, set to false.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Initial Super Admin Bootstrap (Developer Role)
INITIAL_SUPER_ADMIN_USERNAME=superadmin
INITIAL_SUPER_ADMIN_PASSWORD=replace_with_a_secure_superadmin_password_in_production
INITIAL_SUPER_ADMIN_FULL_NAME=System Developer & Super Admin

# Initial Admin Bootstrap (if not running CLI app.cli.create_user)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_a_secure_admin_password_in_production
INITIAL_ADMIN_FULL_NAME=District Collector

# Demo Accounts (Disabled by default; strictly disallowed in production)
# To enable for local evaluation, set ENABLE_DEV_DEMO_ACCOUNTS=true and configure demo passwords below in your local .env
ENABLE_DEV_DEMO_ACCOUNTS=false
# Evaluation demo passwords below are required ONLY when ENABLE_DEV_DEMO_ACCOUNTS=true
EVAL_DEMO_PASSWORD=
EVAL_DEMO_SUPERADMIN_PASSWORD=
EVAL_DEMO_ADMIN_PASSWORD=
EVAL_DEMO_FIELD_OFFICER_PASSWORD=
EVAL_DEMO_EQUIP_COORD_PASSWORD=

# Public Self-Registration (Disabled by default)
ENABLE_PUBLIC_REGISTRATION=false
# Auto-Approve Self-Registration (Strictly forbidden in production; optional for local testing)
AUTO_APPROVE_PUBLIC_REGISTRATION=false
